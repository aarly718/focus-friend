{
  "manifest_version": 3,
  "name": "Focus Friend",
  "version": "1.0.0",
  "description": "A cute study buddy that cheers you on and gets distracted when you do.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "alarms", "notifications", "sidePanel"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "art.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/pets/*.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Focus Friend" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
